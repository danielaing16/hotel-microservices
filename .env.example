# Base de datos de Auth Service
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=postgres123
AUTH_DB_NAME=hotel_auth_db
AUTH_DB_PORT=5432

# Base de datos de Hotels Service
HOTELS_DB_USER=postgres
HOTELS_DB_PASSWORD=postgres123
HOTELS_DB_NAME=hotel_hotels_db
HOTELS_DB_PORT=5433
HOTELS_PORT=3002

# Microservicio de Notificaciones (Worker RabbitMQ + PDF)
NOTIFICATIONS_PORT=3008

# Broker de Mensajería RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_QUEUE=hotel_notifications_queue

# Configuración Nodemailer (Gmail / SMTP Profesional)
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true
SMTP_FROM="Travel & Resorts <reservas@travel-resorts.com>"

# Seguridad JWT Compartida
JWT_SECRET=super_secret_jwt_key_hotel_2026_dev
JWT_EXPIRES_IN=24h

# Puertos
AUTH_PORT=3001
GATEWAY_PORT=3000

# Microservices URLs para Gateway
AUTH_SERVICE_URL=http://auth-service:3001
HOTELS_SERVICE_URL=http://hotels-service:3002
ROOMS_SERVICE_URL=http://rooms-service:3003
AVAILABILITY_SERVICE_URL=http://availability-service:3004
BOOKINGS_SERVICE_URL=http://booking-service:3005
PAYMENTS_SERVICE_URL=http://payment-service:3006
NOTIFICATIONS_SERVICE_URL=http://notification-service:3008
