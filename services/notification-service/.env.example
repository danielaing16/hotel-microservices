PORT=3008
NODE_ENV=development

# Broker de Mensajería RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_QUEUE=hotel_notifications_queue

# Configuración Nodemailer (Mailtrap o SendGrid)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM="Travel & Resorts <reservas@travel-resorts.com>"

# URLs del Sistema
FRONTEND_URL=http://localhost
API_GATEWAY_URL=http://localhost:3000

