PORT=3004
NODE_ENV=development

# Base de datos PostgreSQL de Availability Service
DB_HOST=localhost
DB_PORT=5435
DB_USERNAME=postgres
DB_PASSWORD=postgres123
DB_DATABASE=hotel_availability_db

# Redis para Locks Distribuidos (Redlock) y Soft-Locks (Holds)
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=hotel_notifications_queue

# Microservicio downstream de habitaciones
ROOMS_SERVICE_URL=http://localhost:3003

# Secreto JWT compartido con API Gateway y Auth Service
JWT_SECRET=super_secret_jwt_key_hotel_2026_dev

